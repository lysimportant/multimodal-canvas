# 服务器部署模板：复制为私有 .env.compose 后填写所有 YOUR_* 占位符。
# Web 仅绑定服务器本机 127.0.0.1:60000；公网由 server profile 的 Caddy 通过 80/443 提供 HTTPS。
MC_HTTP_PORT=60000
MC_DOMAIN=love.lolicon.beer
CANVAS_WEB_URL=https://love.lolicon.beer
NEW_API_REDIRECT_URI=https://love.lolicon.beer/v1/auth/newapi/callback
# Canvas Web 与 API 由同一域名网关提供，保持为空。
CORS_ORIGIN=

# Cloudflare R2 必填：bucket 必须已创建并保持私有。
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_R2_SECRET_KEY
# 默认通过 Canvas 限时签名接口向 Provider 提供素材；仅按已确认合同覆盖。
# S3_PROVIDER_ENDPOINT=https://objects.example.com

# New API 独立部署，以下 client、instance 和 secret 必须与 New API 登记一致。
NEW_API_ISSUER=https://api.lolicon.beer
NEW_API_CLIENT_ID=canvas
NEW_API_INSTANCE_ID=main
NEW_API_CLIENT_SECRET=YOUR_NEW_API_CLIENT_SECRET
NEW_API_VIDEO_CONTRACT=newapi-video-v1

# 可选运行配置。
NEW_API_ADMIN_USER_IDS=
RUN_QUEUE_NAME=canvas-accounts-v1
WORKER_CONCURRENCY=20

# 默认使用 Compose 内置 PostgreSQL；使用 Neon 时取消注释并叠加 compose.neon.yaml。
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
