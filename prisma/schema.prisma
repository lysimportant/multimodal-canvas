generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum NodeMode {
  SOURCE
  GENERATE
  TRANSFORM
}

enum AssetStatus {
  READY
  ARCHIVED
}

enum RunStatus {
  DRAFT
  QUEUED
  PREPARING
  RUNNING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String?
  displayName String?
  role        UserRole @default(USER)
  status      String   @default("active")
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects       Project[]
  assets         Asset[]
  runs           Run[]
  uploadSessions UploadSession[]
  aiCredentials  AiCredential[]
  usageLedger    UsageLedger[]
  authSessions   AuthSession[]
  newApiIdentity NewApiIdentity?

  @@index([email])
  @@map("users")
}

/// 身份只按受信任发行站点和不可变用户 ID 关联；邮箱和昵称不参与合并。
model NewApiIdentity {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @unique @db.Uuid
  issuer         String
  externalUserId String
  instanceId     String
  grantId        String
  encryptedGrant String
  expiresAt      DateTime
  status         String               @default("active")
  syncedAt       DateTime?
  syncError      String?
  preferences    Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  groups         NewApiGroupBinding[]

  @@unique([issuer, externalUserId])
  @@map("newapi_identities")
}

/// 服务端一次性登录事务；只保存浏览器绑定摘要和加密 PKCE verifier。
model NewApiLoginTransaction {
  stateHash         String    @id
  browserHash       String
  encryptedVerifier String
  returnPath        String    @default("/workspace")
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([expiresAt])
  @@map("newapi_login_transactions")
}

/// 本地退出先持久保存待撤销授权；远端恢复后仅重试同一授权，不影响重新登录产生的新授权。
model NewApiGrantRevocation {
  id             String    @id
  issuer         String
  instanceId     String
  encryptedGrant String
  completedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([completedAt])
  @@map("newapi_grant_revocations")
}

/// 每个本人纳入组只有一个管理关系；撤销和改组保留墓碑，不隐式重建。
model NewApiGroupBinding {
  id                 String                     @id @default(uuid()) @db.Uuid
  identityId         String                     @db.Uuid
  group              String
  operationId        String                     @unique
  upstreamTokenId    String?
  credentialId       String?                    @unique @db.Uuid
  credentialRevision String?
  permissionRevision String?
  autoGroups         String[]                   @default([])
  status             String                     @default("pending")
  error              String?
  catalog            Json?
  syncedAt           DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  identity           NewApiIdentity             @relation(fields: [identityId], references: [id], onDelete: Restrict)
  credential         AiCredential?              @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  rotations          NewApiCredentialRotation[]

  @@unique([identityId, group])
  @@map("newapi_group_bindings")
}

/// 受控轮换的持久意图及旧版本密文；同一凭据版本只轮换一次，失败沿原操作恢复。
model NewApiCredentialRotation {
  id              String             @id @default(uuid()) @db.Uuid
  bindingId       String             @db.Uuid
  credentialId    String             @db.Uuid
  fromVersion     Int
  upstreamTokenId String
  fromRevision    String
  baseUrl         String
  encryptedApiKey String
  encryptionKeyId String?
  keyFingerprint  String
  createdAt       DateTime           @default(now())
  completedAt     DateTime?
  binding         NewApiGroupBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@unique([credentialId, fromVersion])
  @@index([bindingId, completedAt])
  @@map("newapi_credential_rotations")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  lastUsedAt        DateTime?
  absoluteExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// 管理行为的审计摘要，不保存密码、验证码、邮件密钥或资源内容。
model AccountAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  ownerId   String?  @db.Uuid
  targetId  String?
  action    String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@map("account_audit")
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String?   @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  owner         User?                 @relation(fields: [ownerId], references: [id])
  canvas        Canvas?
  assets        Asset[]
  runs          Run[]
  aiCredentials AiCredential[]
  modelDefaults ProjectModelDefault[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("projects")
}

model Canvas {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  revision  Int      @default(0)
  /// 布局区域列表。组只表达画布布局，不进入运行 DAG；旧画布为 NULL。
  groups    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   CanvasNode[]
  edges   CanvasEdge[]

  @@map("canvases")
}

model CanvasNode {
  id         String    @id
  canvasId   String    @db.Uuid
  type       MediaType
  mode       NodeMode
  label      String
  positionX  Float
  positionY  Float
  assetId    String?   @db.Uuid
  contentUrl String?
  data       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  canvas      Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  sourceEdges CanvasEdge[] @relation("SourceNode")
  targetEdges CanvasEdge[] @relation("TargetNode")

  @@index([canvasId])
  @@index([assetId])
  @@map("nodes")
}

model CanvasEdge {
  id           String   @id
  canvasId     String   @db.Uuid
  sourceNodeId String
  sourceHandle String
  targetNodeId String
  targetHandle String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  canvas Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source CanvasNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target CanvasNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([sourceNodeId])
  @@index([targetNodeId, targetHandle, sortOrder])
  @@map("edges")
}

model Asset {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String?     @db.Uuid
  ownerId    String?     @db.Uuid
  name       String
  mediaType  MediaType
  mimeType   String
  sizeBytes  BigInt
  sha256     String?
  status     AssetStatus @default(READY)
  contentKey String
  tags       String[]    @default([])
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  archivedAt DateTime?

  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner    User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  versions AssetVersion[]
  nodes    CanvasNode[]

  @@index([projectId, status, updatedAt])
  @@index([ownerId])
  @@map("assets")
}

model AssetVersion {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  version    Int
  sizeBytes  BigInt
  sha256     String?
  contentKey String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@map("asset_versions")
}

model UploadSession {
  id         String    @id @default(uuid()) @db.Uuid
  uploadId   String    @unique
  ownerId    String?   @db.Uuid
  name       String
  mimeType   String
  mediaType  MediaType
  sizeBytes  BigInt
  sha256     String
  tags       String[]  @default([])
  contentKey String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  expiresAt  DateTime

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerId])
  @@map("upload_sessions")
}

model Run {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  userId            String?   @db.Uuid
  status            RunStatus @default(DRAFT)
  modelAlias        String?
  credentialId      String?   @db.Uuid
  credentialVersion Int?
  snapshot          Json
  parameters        Json?
  result            Json?
  /// 按节点记录的执行生命周期时间；旧运行记录为 NULL，界面显示未记录。
  nodeTimings       Json?
  attempt           Int       @default(1)
  retryOf           String?   @db.Uuid
  idempotencyKey    String?
  cost              Decimal?  @db.Decimal(18, 6)
  costCurrency      String?
  error             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  inputs         RunInput[]
  providerJobs   ProviderJob[]
  usageLedger    UsageLedger[]
  requestPrompts RunRequestPrompt[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([retryOf])
  @@map("runs")
}

model RunInput {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  nodeId        String
  role          String
  sortOrder     Int
  sourceAssetId String?  @db.Uuid
  snapshot      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@map("run_inputs")
}

model ProviderJob {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  provider      String
  platformJobId String?
  status        String
  progress      Int      @default(0)
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([provider, platformJobId])
  @@index([runId])
  @@map("provider_jobs")
}

/// 一次请求真正发送的提示词记录。请求文本属于用户内容：runId 关联到 Run 的
/// 项目/用户权限边界，列表只读摘要、完整文本按需读取。不保存原始 HTTP body、
/// base64、临时签名 URL 或媒体二进制；也绝不写入日志或错误消息。
model RunRequestPrompt {
  id                String    @id @default(uuid()) @db.Uuid
  /// 数据库 Run.id；用于沿用运行的项目/用户权限边界与级联删除。
  runId             String    @db.Uuid
  /// 记录自身的运行身份，与 requestPromptRecordKey 的 runId 一致；外部运行标识
  /// 不是 UUID，必须单独保留才能复现记录身份。
  requestRunId      String
  nodeId            String
  attempt           Int
  requestIdentity   String
  schemaVersion     Int       @default(1)
  provider          String
  modelAlias        String
  /// 冻结构建的凭据标识（非明文 Key）；旧记录可为空。
  credentialId      String?
  credentialVersion Int?
  mediaType         MediaType
  /// 'plain' | 'messages'，与 requestPromptFormatSchema 一致。
  format            String
  /// 按实际发送顺序排列的文本块：[{ order, role?, name?, text }]。
  parts             Json
  negativeText      String?
  /// 参考资源身份：[{ assetId?, assetVersion?, role, sortOrder, mediaType? }]。
  resources         Json
  /// 'pending' | 'sent' | 'failed' | 'unknown'，与 requestPromptSendStatusSchema 一致。
  sendStatus        String
  /// 归档完成后写入的结果身份；缺失表示本次请求没有产出可展示的资产版本。
  assetId           String?
  assetVersion      Int?
  summary           String?
  summarySource     String?
  createdAt         DateTime
  updatedAt         DateTime  @default(now()) @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([requestRunId, nodeId, attempt, requestIdentity])
  @@index([runId, createdAt])
  @@index([runId, nodeId])
  @@index([assetId])
  @@map("run_request_prompts")
}

model UsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String?  @db.Uuid
  userId         String?  @db.Uuid
  providerJobId  String?
  eventId        String?
  kind           String?
  idempotencyKey String?  @unique
  amount         Decimal  @db.Decimal(18, 6)
  currency       String   @default("USD")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  run  Run?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([userId, createdAt])
  @@index([providerJobId, eventId, kind])
  @@map("usage_ledger")
}

model AiCredential {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @db.Uuid
  ownerId         String?  @db.Uuid
  label           String
  baseUrl         String
  encryptedApiKey String
  /// 密文包装所用的部署密钥标识；旧 AES-GCM 行可为空，不包含密钥材料。
  encryptionKeyId String?
  keyFingerprint  String
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner                User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  projectModelDefaults ProjectModelDefault[]
  newApiGroup          NewApiGroupBinding?

  @@index([projectId])
  @@map("ai_credentials")
}

model ProjectModelDefault {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  mediaType    MediaType
  modelAlias   String
  credentialId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([projectId, mediaType])
  @@index([credentialId])
  @@map("project_model_defaults")
}

/// 与 Run 和执行授权一起提交；重复投递始终使用相同 jobId。
model RunOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @unique
  /// 队列命名空间随提交冻结，避免不同部署共享数据库时互相抢投。
  queueName   String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt, createdAt])
  @@map("run_outbox")
}

/// 无钱包执行授权；与 Run 和 outbox 在同一事务创建，队列不能自报授权。
model ExecutionAuthorization {
  runId               String   @id
  databaseRunId       String   @unique @db.Uuid
  userId              String   @db.Uuid
  projectId           String   @db.Uuid
  snapshot            Json
  snapshotFingerprint String
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@map("execution_authorizations")
}

/// 每个执行节点的首次发送意图；unknown 必须恢复原请求身份，不得重复创建。
model RunSendIntent {
  id                String   @id @default(uuid()) @db.Uuid
  runId             String
  nodeId            String
  attempt           Int
  requestIdentity   String
  status            String   @default("pending")
  providerRequestId String?
  platformJobId     String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([runId, nodeId, attempt])
  @@index([status, updatedAt])
  @@map("run_send_intents")
}

/// 用户跨项目共享的 Skill 库；内置项仅保存启用覆盖，无用户外键以支持本地身份。
model PromptSkillRecord {
  /// 认证 principal.userId；仅关闭认证的本地开发允许 __local__。
  ownerId     String
  /// 内置目录 ID 或服务器生成的 custom_UUID，客户端不得指定新 ID。
  id          String
  builtin     Boolean  @default(false)
  enabled     Boolean  @default(true)
  /// 从 1 递增；更新和删除必须原子匹配调用方的当前修订号。
  revision    Int      @default(1)
  /// 内置项的定义字段均为 NULL，始终使用应用随版本发布的目录。
  name        String?
  category    String?
  description String?
  instruction String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([ownerId, id])
  @@map("prompt_skills")
}

model WebhookEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  eventId                  String    @unique
  provider                 String
  payload                  Json
  status                   String    @default("received")
  attemptCount             Int       @default(0)
  processingToken          String?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  lastError                String?
  receivedAt               DateTime  @default(now())
  processedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  @@index([status, processingLeaseExpiresAt])
  @@map("webhook_events")
}
