generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum NodeMode {
  SOURCE
  GENERATE
  TRANSFORM
}

enum AssetStatus {
  READY
  ARCHIVED
}

enum RunStatus {
  DRAFT
  QUEUED
  PREPARING
  RUNNING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String?
  passwordHash String?
  role         UserRole @default(USER)
  status       String   @default("active")
  bio          String?
  avatarUrl    String?
  emailVerifiedAt DateTime?
  verificationRequired Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects       Project[]
  assets         Asset[]
  runs           Run[]
  uploadSessions UploadSession[]
  aiCredentials  AiCredential[]
  usageLedger    UsageLedger[]
  authSessions   AuthSession[]
  wallet         Wallet?

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  lastUsedAt DateTime?
  absoluteExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// 首次管理员初始化的独立持久化标记，管理员数量变化不会重新开放初始化。
model AdminBootstrap {
  id            String   @id @default("singleton")
  initializedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  @@map("admin_bootstrap")
}

/// 只持久化带服务端密钥的验证码摘要；用途、有效期和尝试次数共同约束消费。
model EmailChallenge {
  id        String @id @default(uuid()) @db.Uuid
  email     String
  purpose   String
  userId    String? @db.Uuid
  codeHash  String
  payload   Json
  attempts  Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([email, purpose])
  @@map("email_challenges")
}

/// 邮件投递只记录脱敏诊断及 SMTP 接收状态，不存验证码或邮件正文。
model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid
  to String
  purpose String
  status String
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([createdAt])
  @@map("email_deliveries")
}

/// 管理行为的审计摘要，不保存密码、验证码、邮件密钥或资源内容。
model AccountAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  ownerId String? @db.Uuid
  targetId String?
  action String
  summary String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@map("account_audit")
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String?   @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  owner         User?                 @relation(fields: [ownerId], references: [id])
  canvas        Canvas?
  assets        Asset[]
  runs          Run[]
  aiCredentials AiCredential[]
  modelDefaults ProjectModelDefault[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("projects")
}

model Canvas {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  revision  Int      @default(0)
  /// 布局区域列表。组只表达画布布局，不进入运行 DAG；旧画布为 NULL。
  groups    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   CanvasNode[]
  edges   CanvasEdge[]

  @@map("canvases")
}

model CanvasNode {
  id         String    @id
  canvasId   String    @db.Uuid
  type       MediaType
  mode       NodeMode
  label      String
  positionX  Float
  positionY  Float
  assetId    String?   @db.Uuid
  contentUrl String?
  data       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  canvas      Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  sourceEdges CanvasEdge[] @relation("SourceNode")
  targetEdges CanvasEdge[] @relation("TargetNode")

  @@index([canvasId])
  @@index([assetId])
  @@map("nodes")
}

model CanvasEdge {
  id           String   @id
  canvasId     String   @db.Uuid
  sourceNodeId String
  sourceHandle String
  targetNodeId String
  targetHandle String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  canvas Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source CanvasNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target CanvasNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([sourceNodeId])
  @@index([targetNodeId, targetHandle, sortOrder])
  @@map("edges")
}

model Asset {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String?     @db.Uuid
  ownerId    String?     @db.Uuid
  name       String
  mediaType  MediaType
  mimeType   String
  sizeBytes  BigInt
  sha256     String?
  status     AssetStatus @default(READY)
  contentKey String
  tags       String[]    @default([])
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  archivedAt DateTime?

  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner    User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  versions AssetVersion[]
  nodes    CanvasNode[]

  @@index([projectId, status, updatedAt])
  @@index([ownerId])
  @@map("assets")
}

model AssetVersion {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  version    Int
  sizeBytes  BigInt
  sha256     String?
  contentKey String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@map("asset_versions")
}

model UploadSession {
  id         String    @id @default(uuid()) @db.Uuid
  uploadId   String    @unique
  ownerId    String?   @db.Uuid
  name       String
  mimeType   String
  mediaType  MediaType
  sizeBytes  BigInt
  sha256     String
  tags       String[]  @default([])
  contentKey String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  expiresAt  DateTime

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerId])
  @@map("upload_sessions")
}

model Run {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  userId            String?   @db.Uuid
  status            RunStatus @default(DRAFT)
  modelAlias        String?
  credentialId      String?   @db.Uuid
  credentialVersion Int?
  snapshot          Json
  parameters        Json?
  result            Json?
  /// 按节点记录的执行生命周期时间；旧运行记录为 NULL，界面显示未记录。
  nodeTimings       Json?
  attempt           Int       @default(1)
  retryOf           String?   @db.Uuid
  idempotencyKey    String?
  cost              Decimal?  @db.Decimal(18, 6)
  costCurrency      String?
  error             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  inputs         RunInput[]
  providerJobs   ProviderJob[]
  usageLedger    UsageLedger[]
  requestPrompts RunRequestPrompt[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([retryOf])
  @@map("runs")
}

model RunInput {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  nodeId        String
  role          String
  sortOrder     Int
  sourceAssetId String?  @db.Uuid
  snapshot      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@map("run_inputs")
}

model ProviderJob {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  provider      String
  platformJobId String?
  status        String
  progress      Int      @default(0)
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([provider, platformJobId])
  @@index([runId])
  @@map("provider_jobs")
}

/// 一次请求真正发送的提示词记录。请求文本属于用户内容：runId 关联到 Run 的
/// 项目/用户权限边界，列表只读摘要、完整文本按需读取。不保存原始 HTTP body、
/// base64、临时签名 URL 或媒体二进制；也绝不写入日志或错误消息。
model RunRequestPrompt {
  id                String    @id @default(uuid()) @db.Uuid
  /// 数据库 Run.id；用于沿用运行的项目/用户权限边界与级联删除。
  runId             String    @db.Uuid
  /// 记录自身的运行身份，与 requestPromptRecordKey 的 runId 一致；外部运行标识
  /// 不是 UUID，必须单独保留才能复现记录身份。
  requestRunId      String
  nodeId            String
  attempt           Int
  requestIdentity   String
  schemaVersion     Int       @default(1)
  provider          String
  modelAlias        String
  /// 冻结构建的凭据标识（非明文 Key）；旧记录可为空。
  credentialId      String?
  credentialVersion Int?
  mediaType         MediaType
  /// 'plain' | 'messages'，与 requestPromptFormatSchema 一致。
  format            String
  /// 按实际发送顺序排列的文本块：[{ order, role?, name?, text }]。
  parts             Json
  negativeText      String?
  /// 参考资源身份：[{ assetId?, assetVersion?, role, sortOrder, mediaType? }]。
  resources         Json
  /// 'pending' | 'sent' | 'failed' | 'unknown'，与 requestPromptSendStatusSchema 一致。
  sendStatus        String
  /// 归档完成后写入的结果身份；缺失表示本次请求没有产出可展示的资产版本。
  assetId           String?
  assetVersion      Int?
  summary           String?
  summarySource     String?
  createdAt         DateTime
  updatedAt         DateTime  @default(now()) @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([requestRunId, nodeId, attempt, requestIdentity])
  @@index([runId, createdAt])
  @@index([runId, nodeId])
  @@index([assetId])
  @@map("run_request_prompts")
}

model UsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String?  @db.Uuid
  userId         String?  @db.Uuid
  providerJobId  String?
  eventId        String?
  kind           String?
  idempotencyKey String?  @unique
  amount         Decimal  @db.Decimal(18, 6)
  currency       String   @default("USD")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  run  Run?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([userId, createdAt])
  @@index([providerJobId, eventId, kind])
  @@map("usage_ledger")
}

model AiCredential {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @db.Uuid
  ownerId         String?  @db.Uuid
  label           String
  baseUrl         String
  encryptedApiKey String
  /// 密文包装所用的部署密钥标识；旧 AES-GCM 行可为空，不包含密钥材料。
  encryptionKeyId String?
  keyFingerprint  String
  version         Int      @default(1)
  defaultModels   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project              Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner                User?                     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  models               ModelCatalog[]
  capabilityOverrides  ModelCapabilityOverride[]
  projectModelDefaults ProjectModelDefault[]
  platformBindings     ModelBinding[]

  @@index([projectId])
  @@map("ai_credentials")
}

model ModelCatalog {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String?   @db.Uuid
  modelAlias   String
  name         String
  mediaType    MediaType
  capabilities Json?
  limitations  Json?
  price        Json?
  refreshedAt  DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, modelAlias, mediaType])
  @@index([credentialId, mediaType])
  @@map("model_catalog")
}

model ModelCapabilityOverride {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String?   @db.Uuid
  modelAlias   String
  mediaType    MediaType
  capabilities Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, modelAlias, mediaType])
  @@map("model_capability_overrides")
}

model ProjectModelDefault {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  mediaType    MediaType
  modelAlias   String
  /// 平台身份跨 API 更换保留；空值的旧引用提交前必须唯一映射。
  platformModelId String? @db.Uuid
  credentialId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([projectId, mediaType])
  @@index([credentialId])
  @@map("project_model_defaults")
}

/// 独立的平台商品身份；同步候选目录或更换连接不会删除人工字段、价格和历史引用。
model PlatformModel {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  description            String   @default("")
  mediaType              MediaType
  specifications         Json     @default("{}")
  status                 String   @default("draft")
  sortOrder              Int      @default(0)
  sourceSyncId           String?  @db.Uuid
  sourceModelId          String?
  activeBindingId        String?  @unique @db.Uuid
  activePricingVersionId String?  @unique @db.Uuid
  createdBy              String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  activeBinding ModelBinding? @relation("ActiveModelBinding", fields: [activeBindingId], references: [id], onDelete: Restrict)
  activePrice PricingVersion? @relation("ActiveModelPrice", fields: [activePricingVersionId], references: [id], onDelete: Restrict)
  bindings ModelBinding[] @relation("PlatformBindings")
  prices PricingVersion[] @relation("PlatformPrices")

  @@index([status, mediaType, sortOrder])
  @@map("platform_models")
}

/// 不可变调用绑定；凭据、精确模型 ID、合同及能力验证证据随修订号冻结。
model ModelBinding {
  id                   String   @id @default(uuid()) @db.Uuid
  platformModelId      String   @db.Uuid
  revision             Int
  credentialId         String   @db.Uuid
  credentialVersion    Int
  upstreamModelId      String
  contract             String
  capabilities         Json     @default("{}")
  limitations          Json     @default("{}")
  verificationEvidence String
  verifiedAt           DateTime
  createdBy            String   @db.Uuid
  createdAt            DateTime @default(now())

  model PlatformModel @relation("PlatformBindings", fields: [platformModelId], references: [id], onDelete: Restrict)
  activeFor PlatformModel? @relation("ActiveModelBinding")
  credential AiCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([platformModelId, revision])
  @@index([credentialId])
  @@map("model_bindings")
}

/// 不可变人民币售价版本；rule 中金额均为十亿分之一元的整数字符串。
model PricingVersion {
  id              String   @id @default(uuid()) @db.Uuid
  platformModelId String   @db.Uuid
  revision        Int
  currency        String   @default("CNY")
  rule            Json
  effectiveAt     DateTime @default(now())
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())

  model PlatformModel @relation("PlatformPrices", fields: [platformModelId], references: [id], onDelete: Restrict)
  activeFor PlatformModel? @relation("ActiveModelPrice")

  @@unique([platformModelId, revision])
  @@map("pricing_versions")
}

/// 钱包快照与追加流水同事务更新；金额单位为 10^-9 CNY，不使用浮点金额。
model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  currency       String   @default("CNY")
  availableNanos Decimal  @default(0) @db.Decimal(38, 0)
  heldNanos      Decimal  @default(0) @db.Decimal(38, 0)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries WalletEntry[]

  @@map("wallets")
}

/// 只追加的财务动作；同一幂等键必须具有相同动作、金额、关联对象和操作者。
model WalletEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  walletId            String   @db.Uuid
  kind                String
  availableDeltaNanos Decimal  @db.Decimal(38, 0)
  heldDeltaNanos      Decimal  @db.Decimal(38, 0)
  availableAfterNanos Decimal  @db.Decimal(38, 0)
  heldAfterNanos      Decimal  @db.Decimal(38, 0)
  idempotencyKey      String   @unique
  runId               String?
  chargeItemId        String?  @db.Uuid
  relatedEntryId      String?  @db.Uuid
  actorId             String?  @db.Uuid
  reason              String
  createdAt           DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([chargeItemId])
  @@map("wallet_entries")
}

/// 服务端生成、付款人和执行快照绑定的短期报价；消费后仅能恢复原 Run。
model BillingQuote {
  id            String   @id @default(uuid()) @db.Uuid
  payerId       String   @db.Uuid
  requestHash   String
  snapshot      Json
  items         Json
  maximumNanos  Decimal  @db.Decimal(38, 0)
  expiresAt     DateTime
  consumedRunId String?  @unique
  createdAt     DateTime @default(now())

  @@index([payerId, createdAt])
  @@index([expiresAt])
  @@map("billing_quotes")
}

/// 运行账单汇总；runId 使用队列稳定身份，不随运行历史清理级联删除财务记录。
model RunCharge {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @unique
  payerId       String   @db.Uuid
  quoteId       String   @unique @db.Uuid
  requestHash   String
  maximumNanos  Decimal  @db.Decimal(38, 0)
  createdAt     DateTime @default(now())

  items ChargeItem[]

  @@index([payerId, createdAt])
  @@map("run_charges")
}

/// 每个实际逻辑子调用的冻结与交付证据；释放或退款后不允许迟到结果重新扣费。
model ChargeItem {
  id                 String   @id @default(uuid()) @db.Uuid
  runChargeId        String   @db.Uuid
  nodeId             String
  executionIdentity  String   @unique
  platformModelId    String   @db.Uuid
  bindingId          String   @db.Uuid
  pricingVersionId   String   @db.Uuid
  pricingRule        Json
  quoteInput         Json
  maximumNanos       Decimal  @db.Decimal(38, 0)
  settledNanos       Decimal  @default(0) @db.Decimal(38, 0)
  refundedNanos      Decimal  @default(0) @db.Decimal(38, 0)
  status             String   @default("HELD")
  executionState     String   @default("unsent")
  providerRequestId  String?
  deliveryEvidence   Json?
  usage              Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  charge RunCharge @relation(fields: [runChargeId], references: [id], onDelete: Restrict)
  providerCost ProviderCost?

  @@unique([runChargeId, nodeId])
  @@index([status, updatedAt])
  @@map("charge_items")
}

/// 上游原币种成本独立于用户结算；未知成本不能伪记为零或触发生成重放。
model ProviderCost {
  id             String   @id @default(uuid()) @db.Uuid
  chargeItemId   String   @unique @db.Uuid
  status         String   @default("unknown")
  amount         Decimal? @db.Decimal(38, 12)
  currency       String?
  source         String?
  evidence       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item ChargeItem @relation(fields: [chargeItemId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@map("provider_costs")
}

/// 待核实事项只经明确证据或人工决策关闭；到期用于升级处理，不自动退款或重发。
model ReconciliationItem {
  id           String   @id @default(uuid()) @db.Uuid
  chargeItemId String   @db.Uuid
  kind         String
  reason       String
  status       String   @default("open")
  dueAt        DateTime
  resolution   String?
  resolvedBy   String?  @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([chargeItemId, kind])
  @@index([status, dueAt])
  @@map("reconciliation_items")
}

/// 与 Run、报价消费和冻结一起提交；重复投递始终使用相同 jobId。
model RunOutbox {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @unique
  /// 队列命名空间随提交冻结，避免不同部署共享数据库时互相抢投。
  queueName   String
  payload     Json
  publishedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt, createdAt])
  @@map("run_outbox")
}

/// 同步候选的独立证据；失败保留上次候选，不覆盖人工商品和售价。
model ModelCatalogSync {
  id           String   @id @default(uuid()) @db.Uuid
  credentialId String   @db.Uuid
  status       String
  candidates   Json
  missing      Json
  errorCode    String?
  createdBy    String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([credentialId, createdAt])
  @@map("model_catalog_syncs")
}

/// 切换时刻用于识别迁移前的无账务历史运行，之后的新调用必须有冻结记录。
model BillingActivation {
  id        String   @id @default("singleton")
  createdAt DateTime @default(now())

  @@map("billing_activation")
}

/// 用户跨项目共享的 Skill 库；内置项仅保存启用覆盖，无用户外键以支持本地身份。
model PromptSkillRecord {
  /// 认证 principal.userId；仅关闭认证的本地开发允许 __local__。
  ownerId     String
  /// 内置目录 ID 或服务器生成的 custom_UUID，客户端不得指定新 ID。
  id          String
  builtin     Boolean  @default(false)
  enabled     Boolean  @default(true)
  /// 从 1 递增；更新和删除必须原子匹配调用方的当前修订号。
  revision    Int      @default(1)
  /// 内置项的定义字段均为 NULL，始终使用应用随版本发布的目录。
  name        String?
  category    String?
  description String?
  instruction String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([ownerId, id])
  @@map("prompt_skills")
}

model WebhookEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  eventId                  String    @unique
  provider                 String
  payload                  Json
  status                   String    @default("received")
  attemptCount             Int       @default(0)
  processingToken          String?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  lastError                String?
  receivedAt               DateTime  @default(now())
  processedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  @@index([status, processingLeaseExpiresAt])
  @@map("webhook_events")
}
