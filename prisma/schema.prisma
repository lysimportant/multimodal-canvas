generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum NodeMode {
  SOURCE
  GENERATE
  TRANSFORM
}

enum AssetStatus {
  READY
  ARCHIVED
}

enum RunStatus {
  DRAFT
  QUEUED
  PREPARING
  RUNNING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String?
  passwordHash String?
  role         UserRole @default(USER)
  status       String   @default("active")
  bio          String?
  avatarUrl    String?
  emailVerifiedAt DateTime?
  verificationRequired Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects       Project[]
  assets         Asset[]
  runs           Run[]
  uploadSessions UploadSession[]
  aiCredentials  AiCredential[]
  usageLedger    UsageLedger[]
  authSessions   AuthSession[]

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  lastUsedAt DateTime?
  absoluteExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// 首次管理员初始化的独立持久化标记，管理员数量变化不会重新开放初始化。
model AdminBootstrap {
  id            String   @id @default("singleton")
  initializedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  @@map("admin_bootstrap")
}

/// 只持久化带服务端密钥的验证码摘要；用途、有效期和尝试次数共同约束消费。
model EmailChallenge {
  id        String @id @default(uuid()) @db.Uuid
  email     String
  purpose   String
  userId    String? @db.Uuid
  codeHash  String
  payload   Json
  attempts  Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([email, purpose])
  @@map("email_challenges")
}

/// 邮件投递只记录脱敏诊断及 SMTP 接收状态，不存验证码或邮件正文。
model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid
  to String
  purpose String
  status String
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([createdAt])
  @@map("email_deliveries")
}

/// 管理行为的审计摘要，不保存密码、验证码、邮件密钥或资源内容。
model AccountAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  ownerId String? @db.Uuid
  targetId String?
  action String
  summary String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@map("account_audit")
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String?   @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  owner         User?                 @relation(fields: [ownerId], references: [id])
  canvas        Canvas?
  assets        Asset[]
  runs          Run[]
  aiCredentials AiCredential[]
  modelDefaults ProjectModelDefault[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("projects")
}

model Canvas {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   CanvasNode[]
  edges   CanvasEdge[]

  @@map("canvases")
}

model CanvasNode {
  id         String    @id
  canvasId   String    @db.Uuid
  type       MediaType
  mode       NodeMode
  label      String
  positionX  Float
  positionY  Float
  assetId    String?   @db.Uuid
  contentUrl String?
  data       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  canvas      Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  sourceEdges CanvasEdge[] @relation("SourceNode")
  targetEdges CanvasEdge[] @relation("TargetNode")

  @@index([canvasId])
  @@index([assetId])
  @@map("nodes")
}

model CanvasEdge {
  id           String   @id
  canvasId     String   @db.Uuid
  sourceNodeId String
  sourceHandle String
  targetNodeId String
  targetHandle String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  canvas Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source CanvasNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target CanvasNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([sourceNodeId])
  @@index([targetNodeId, targetHandle, sortOrder])
  @@map("edges")
}

model Asset {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String?     @db.Uuid
  ownerId    String?     @db.Uuid
  name       String
  mediaType  MediaType
  mimeType   String
  sizeBytes  BigInt
  sha256     String?
  status     AssetStatus @default(READY)
  contentKey String
  tags       String[]    @default([])
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  archivedAt DateTime?

  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner    User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  versions AssetVersion[]
  nodes    CanvasNode[]

  @@index([projectId, status, updatedAt])
  @@index([ownerId])
  @@map("assets")
}

model AssetVersion {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  version    Int
  sizeBytes  BigInt
  sha256     String?
  contentKey String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@map("asset_versions")
}

model UploadSession {
  id         String    @id @default(uuid()) @db.Uuid
  uploadId   String    @unique
  ownerId    String?   @db.Uuid
  name       String
  mimeType   String
  mediaType  MediaType
  sizeBytes  BigInt
  sha256     String
  tags       String[]  @default([])
  contentKey String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  expiresAt  DateTime

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerId])
  @@map("upload_sessions")
}

model Run {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  userId            String?   @db.Uuid
  status            RunStatus @default(DRAFT)
  modelAlias        String?
  credentialId      String?   @db.Uuid
  credentialVersion Int?
  snapshot          Json
  parameters        Json?
  result            Json?
  attempt           Int       @default(1)
  retryOf           String?   @db.Uuid
  idempotencyKey    String?
  cost              Decimal?  @db.Decimal(18, 6)
  costCurrency      String?
  error             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inputs       RunInput[]
  providerJobs ProviderJob[]
  usageLedger  UsageLedger[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([retryOf])
  @@map("runs")
}

model RunInput {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  nodeId        String
  role          String
  sortOrder     Int
  sourceAssetId String?  @db.Uuid
  snapshot      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@map("run_inputs")
}

model ProviderJob {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  provider      String
  platformJobId String?
  status        String
  progress      Int      @default(0)
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([provider, platformJobId])
  @@index([runId])
  @@map("provider_jobs")
}

model UsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String?  @db.Uuid
  userId         String?  @db.Uuid
  providerJobId  String?
  eventId        String?
  kind           String?
  idempotencyKey String?  @unique
  amount         Decimal  @db.Decimal(18, 6)
  currency       String   @default("USD")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  run  Run?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([userId, createdAt])
  @@index([providerJobId, eventId, kind])
  @@map("usage_ledger")
}

model AiCredential {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @db.Uuid
  ownerId         String?  @db.Uuid
  label           String
  baseUrl         String
  encryptedApiKey String
  /// 密文包装所用的部署密钥标识；旧 AES-GCM 行可为空，不包含密钥材料。
  encryptionKeyId String?
  keyFingerprint  String
  version         Int      @default(1)
  defaultModels   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project              Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner                User?                     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  models               ModelCatalog[]
  capabilityOverrides  ModelCapabilityOverride[]
  projectModelDefaults ProjectModelDefault[]

  @@index([projectId])
  @@map("ai_credentials")
}

model ModelCatalog {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String?   @db.Uuid
  modelAlias   String
  name         String
  mediaType    MediaType
  capabilities Json?
  limitations  Json?
  price        Json?
  refreshedAt  DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, modelAlias, mediaType])
  @@index([credentialId, mediaType])
  @@map("model_catalog")
}

model ModelCapabilityOverride {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String?   @db.Uuid
  modelAlias   String
  mediaType    MediaType
  capabilities Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, modelAlias, mediaType])
  @@map("model_capability_overrides")
}

model ProjectModelDefault {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  mediaType    MediaType
  modelAlias   String
  credentialId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential AiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([projectId, mediaType])
  @@index([credentialId])
  @@map("project_model_defaults")
}

model WebhookEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  eventId                  String    @unique
  provider                 String
  payload                  Json
  status                   String    @default("received")
  attemptCount             Int       @default(0)
  processingToken          String?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  lastError                String?
  receivedAt               DateTime  @default(now())
  processedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  @@index([status, processingLeaseExpiresAt])
  @@map("webhook_events")
}
