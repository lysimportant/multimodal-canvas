NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
# Development binds to loopback; production defaults to 0.0.0.0.
API_HOST=127.0.0.1
API_AUTH_TOKEN=
# Local-only anonymous settings access for the Web UI. Set false when using auth.
API_ALLOW_ANONYMOUS_SETTINGS=true
# Optional HS256 user token verification. Production JWTs must include exp.
# API_AUTH_TOKEN remains useful for service-to-service and platform-admin calls.
API_JWT_SECRET=
# Stable server secret for HMAC asset access URLs. Required when JWT/API token
# secrets are not used as the signing fallback.
ASSET_ACCESS_URL_SECRET=
RUN_MAX_ACTIVE_PER_PROJECT=4
API_RATE_LIMIT_PER_MINUTE=120
CORS_ORIGIN=
MAX_RUN_COST=
RUN_COST_CURRENCY=USD
NEW_API_WEBHOOK_SECRET=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_canvas
REDIS_URL=redis://localhost:6379
# Development defaults to the in-memory run service so the Web UI can start
# without Redis. Set RUN_SERVICE=bullmq when Redis and the worker are available.
RUN_SERVICE=memory
WORKER_PROVIDER=mock
# Worker logs are JSON lines on stdout. Raise to debug only while diagnosing a run.
LOG_LEVEL=info
OTEL_SERVICE_NAME=multimodal-canvas-worker
# Optional vendor-neutral span/error JSON logs. Defaults to disabled; inject an
# OpenTelemetry/Sentry adapter in process startup for external export.
OBSERVABILITY_LOGGING=false
# Optional OTLP HTTP traces and Sentry error export. Both are best effort.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=multimodal-canvas-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
ASSET_STORAGE_ROOT=.data/assets
# Maximum generated result size archived by the Worker (50 MiB default).
RESULT_ASSET_MAX_BYTES=52428800
FFPROBE_ENABLED=false
# Optional absolute path when ffprobe is not available on PATH.
FFPROBE_PATH=
FFMPEG_ENABLED=false
# Optional absolute path when ffmpeg is not available on PATH.
FFMPEG_PATH=

# The gateway origin is accepted too; the server normalizes it to /v1.
NEW_API_BASE_URL=https://newapi.example.com/v1
NEW_API_API_KEY=server-side-platform-key
NEW_API_TIMEOUT_MS=120000
NEW_API_TEXT_MODEL=text-model-alias
NEW_API_IMAGE_MODEL=image-model-alias
NEW_API_AUDIO_MODEL=audio-model-alias
NEW_API_VIDEO_MODEL=video-model-alias
# Video creation and task polling use different gateway paths by default.
NEW_API_VIDEO_CREATE_PATH=/videos/generations
NEW_API_VIDEO_JOBS_PATH=/videos
# Legacy alias for the task path; keep it when using an older gateway.
NEW_API_VIDEO_PATH=/videos
# Async video polling is bounded; increase the attempt count for providers
# whose jobs commonly take longer than four minutes. Set interval to 0 only in tests.
NEW_API_VIDEO_POLL_INTERVAL_MS=2000
NEW_API_VIDEO_MAX_POLL_ATTEMPTS=180
NEW_API_VIDEO_MAX_CONTENT_BYTES=52428800
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-server-secret
