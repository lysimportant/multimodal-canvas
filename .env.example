# 本地 Mock 模式：使用本地文件和内存运行，不调用真实模型或产生钱包费用。
NODE_ENV=development

# CORS：* 或 all 表示回显请求 Origin（支持带凭据请求）；生产建议填写逗号分隔的 HTTPS 来源。
CORS_ORIGIN=*

# 本地进程内运行，不依赖 Redis 或 BullMQ。
RUN_SERVICE=memory

# 真实调用改为 newapi 时，必须同时配置 DATABASE_URL、REDIS_URL、RUN_SERVICE=bullmq。
# 先执行数据库迁移，在管理后台发布模型/绑定/售价并发放内部额度，再由用户确认报价。
# API 和 Worker 共享数据库、队列命名空间及凭据加密配置，不能用 memory 绕过钱包。
# URL 和 API Key 在网页设置页填写，不写入此文件。
WORKER_PROVIDER=mock

# 新视频任务默认走 New API OpenAI 视频 POST /v1/videos 与 GET /v1/videos/{id}（newapi-video-v1）。
# 通用视频设 newapi-unified-v1（/v1/video/generations）；Sub2API 设 legacy-v1（/v1/videos/generations）。不得混用 Sora multipart。
# 已保存平台任务 ID 的历史任务继续使用其冻结协议，不随此配置重建上游任务。
NEW_API_VIDEO_CONTRACT=newapi-video-v1

# BullMQ Worker 的 URL-only 视频参考可选公网对象存储入口。
# 必须以 HTTPS 指向与 S3_ENDPOINT 相同的 bucket/key；签名 URL 的 Host 不能事后替换。
# S3_PROVIDER_ENDPOINT=https://objects.example.com

# API 和 Worker 可选启用本机媒体工具；显式 false 与非空 PATH 不能同时配置。
# FFMPEG_ENABLED=true
# FFMPEG_PATH=ffmpeg
# FFPROBE_ENABLED=true
# FFPROBE_PATH=ffprobe

# 不设置 DATABASE_URL：项目和已加密的 AI 凭据会保存到 API 进程工作目录的 .data/。
# 凭据 JSON 不含明文 Key；首次保存会自动生成同目录的本机加密密钥文件。二者都被 Git 忽略。
# 仅适用于单机、单 API 进程，需保持 RUN_SERVICE=memory。本地删除密钥文件后，已有凭据会被拒绝加载，不能自动恢复。
# 可选：为本地持久化指定文件路径或显式注入部署密钥；不要把真实 Key 写入此示例文件。
# AI_CREDENTIAL_STORAGE_FILE=.data/ai-credentials.json
# AI_CREDENTIAL_ENCRYPTION_KEY_FILE=.data/ai-credentials.key
# AI_CREDENTIAL_ENCRYPTION_KEY=
# AI_CREDENTIAL_ENCRYPTION_KEY_ID=default
# AI_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}
# 轮换前先暂停写入和队列消费，所有 API/Worker 使用同一 current key-id 后再恢复。
# 历史密钥通过部署系统注入；不要把真实密钥 JSON 写入本示例。回滚限制见 docs/credential-rotation.md。
# 生产多实例请配置 DATABASE_URL，并通过部署密钥管理系统提供 AI_CREDENTIAL_ENCRYPTION_KEY。

# JWT 认证签名密钥；本地可使用随机字符串，生产必须通过密钥管理注入。
API_JWT_SECRET=change-this-local-jwt-secret
