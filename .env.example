# 本地接入独立 New API；账号授权与执行均需数据库，不使用手工 Key 或钱包。
NODE_ENV=development
RUN_SERVICE=bullmq
RUN_QUEUE_NAME=canvas-accounts-v1-local
WORKER_PROVIDER=newapi
NEW_API_ISSUER=http://127.0.0.1:13000
NEW_API_CLIENT_ID=canvas
NEW_API_INSTANCE_ID=local
NEW_API_REDIRECT_URI=http://localhost:5173/v1/auth/newapi/callback
CANVAS_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# 将数据库、Redis、对象存储及随机签名/加密密钥放入私有环境文件。
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/canvas
# REDIS_URL=redis://127.0.0.1:6379/0
# API_JWT_SECRET=
# AI_CREDENTIAL_ENCRYPTION_KEY=
# AI_CREDENTIAL_ENCRYPTION_KEY_ID=default
# AI_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}
# NEW_API_CLIENT_SECRET=
# NEW_API_ADMIN_USER_IDS=1
NEW_API_VIDEO_CONTRACT=newapi-video-v1
# URL-only 视频参考要求供应商能读取同一对象。公网部署填写 HTTPS 地址。
# S3_PROVIDER_ENDPOINT=https://objects.example.com
# FFMPEG_ENABLED=true
# FFPROBE_ENABLED=true
# 密钥轮换与回退见 docs/credential-rotation.md。
