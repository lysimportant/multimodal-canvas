# 本地源码开发接入独立 New API 与 R2；启动脚本不会自动读取此文件。
NODE_ENV=development
RUN_SERVICE=bullmq
RUN_QUEUE_NAME=canvas-accounts-v1-local
WORKER_PROVIDER=newapi
WORKER_CONCURRENCY=20
NEW_API_ISSUER=https://api.example.com
NEW_API_CLIENT_ID=canvas
NEW_API_INSTANCE_ID=local
NEW_API_CLIENT_SECRET=
NEW_API_REDIRECT_URI=http://localhost:5173/v1/auth/newapi/callback
CANVAS_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
NEW_API_ADMIN_USER_IDS=
NEW_API_VIDEO_CONTRACT=newapi-video-v1

# docker-compose.dev.yml 仅启动回环 PostgreSQL/Redis；配置专用随机密码。
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://canvas:PASSWORD@127.0.0.1:5432/canvas?schema=public
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
# 可选 Neon 替换 DATABASE_URL；Direct connection，保留 sslmode=require。
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 必选；先创建私有 bucket，授权 Object Read & Write。
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=canvas
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_UPLOAD_MODE=proxy
S3_DOWNLOAD_MODE=proxy
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
# 默认向 Provider 提供本站限时签名地址；公网生成需可达的 HTTPS CANVAS_WEB_URL。
# S3_PROVIDER_ENDPOINT=https://objects.example.com

# 源码开发需自行生成并稳定保存以下密钥，至少 32 字节；Docker 自动使用专用卷。
API_JWT_SECRET=
AI_CREDENTIAL_ENCRYPTION_KEY=
NEW_API_WEBHOOK_SECRET=
FFMPEG_ENABLED=true
FFPROBE_ENABLED=true