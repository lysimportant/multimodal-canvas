# Compose 正式部署的非敏感选项；复制为 .env.compose 后通过 --env-file 指定。
# 与现有开发 .env 分离；真实 Provider Key 必须通过网页设置保存。
MC_HTTP_PORT=8080
MC_HTTPS_PORT=8443
MC_VIDEO_CONTRACT=newapi-unified-v1

# Linux 公网服务器启用 server profile 时，两项必须对应同一已解析的域名。
# MC_DOMAIN=canvas.example.com
# MC_PUBLIC_ORIGIN=https://canvas.example.com
