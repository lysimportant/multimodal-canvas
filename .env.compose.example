# Compose 正式部署的非敏感选项；复制为 .env.compose 后通过 --env-file 指定。
# 与现有开发 .env 分离；各组 Key 由 New API 授权自动建立并加密保存。
MC_HTTP_PORT=8080
MC_HTTPS_PORT=8443
MC_VIDEO_CONTRACT=newapi-video-v1
# 单个 Worker 并行 Run 数，范围 1..20；设为 1 回滚为串行，不改变单 Run DAG。
MC_WORKER_CONCURRENCY=4
# Wan3 视频/音频与 Seedance 2.x 视频参考需要外部 Provider 拉取。
# 此地址必须以 HTTPS 公开访问 compose 内 MinIO 的同一 bucket/key，并原样保留签名 Host；
# 不能填写 localhost、内网地址，也不能签名后替换域名。未使用这些输入时可留空。
# MC_S3_PROVIDER_ENDPOINT=https://objects.example.com
MC_NEW_API_ISSUER=https://api.example.com
MC_NEW_API_CLIENT_ID=canvas
MC_NEW_API_INSTANCE_ID=main
# 必须预先在 New API 配置相同 client、instance 和精确回调地址。
# MC_NEW_API_REDIRECT_URI=https://canvas.example.com/v1/auth/newapi/callback
# 管理员由不可变 New API 用户 ID 映射，多个 ID 用逗号分隔。
# MC_NEW_API_ADMIN_USER_IDS=1
# 可选私有文件只含 NEW_API_CLIENT_SECRET，不再注入邮件配置。
# MC_ACCOUNT_ENV_FILE=/absolute/private/path/canvas-newapi.env
MC_RUN_QUEUE_NAME=canvas-accounts-v1

# Linux 公网服务器启用 server profile 时，两项必须对应同一已解析的域名。
# MC_DOMAIN=canvas.example.com
# MC_PUBLIC_ORIGIN=https://canvas.example.com
