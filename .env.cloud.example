# compose.cloud.yaml 使用的外部服务连接；复制为 .env.cloud 后填写，切勿提交真实值。

# Neon：控制台 Connection Details 选择 "Direct connection"（主机名不带 -pooler），
# Prisma 迁移需要直连；必须保留 sslmode=require。
CLOUD_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2：R2 → Manage API Tokens 创建 Object Read & Write 令牌，限定到该 bucket。
CLOUD_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUD_S3_BUCKET=canvas
CLOUD_S3_REGION=auto
CLOUD_S3_ACCESS_KEY=
CLOUD_S3_SECRET_KEY=
