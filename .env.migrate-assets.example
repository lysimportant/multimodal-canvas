# 复制为私有 .env.migrate-assets；这个文件仅配置旧存储，不替换 .env.compose。
# endpoint 必须从运行迁移脚本的环境可达。Docker 内的 localhost 指容器自身。
MIGRATION_SOURCE_S3_ENDPOINT=http://canvas-assets-recovery-minio:9000
MIGRATION_SOURCE_S3_BUCKET=canvas
MIGRATION_SOURCE_S3_ACCESS_KEY=
MIGRATION_SOURCE_S3_SECRET_KEY=
MIGRATION_SOURCE_S3_REGION=us-east-1

# 只有从旧卷副本临时恢复 MinIO 时填写这两项；使用副本实例的登录凭据，
# 并让上面的 ACCESS_KEY / SECRET_KEY 与它们一致。不把凭据写入命令参数。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
